# Supabase (browser bundle + serverless functions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. These are read inside /api/* and are never prefixed with
# VITE_, so Vite keeps them out of the browser bundle. Do not rename them to
# VITE_*_API_KEY: any VITE_ variable is embedded in the shipped JavaScript.
#
# The "-latest" aliases below are frequently saturated with "503 high demand".
# api/_lib/providers.ts walks a fallback chain, so a saturated model degrades
# into a slower response rather than a failure. gemini-1.5-flash and
# gemini-2.0-flash are retired and will not work; gemini-flash-lite-latest is
# the cheapest and least contended option if you want fast local runs.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_VISION_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=your-groq-key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=

# Only needed to run `npm run host:specimens` or `npm run host:extended`, which copy
# cached photos from .cache/ into the public `insect-images` bucket. The first also
# repoints insects.images at them; the second only uploads, leaving the database
# references to migration 00015. The service_role key bypasses RLS, so never commit
# it and never prefix it with VITE_. Remove it from .env afterwards.
SUPABASE_SERVICE_ROLE_KEY=
